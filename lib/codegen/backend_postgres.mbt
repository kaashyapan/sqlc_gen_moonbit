// PostgreSQL backend (native target)

///|
pub fn generate_queries_postgres(
  request : @plugin.GenerateRequest,
  overrides : Array[TypeOverride],
) -> String {
  let buf = StringBuilder::new()
  buf.write_string("// Generated by sqlc-gen-moonbit (backend: postgres)\n")
  buf.write_string("// Requires: moonbit-community/postgres\n\n")

  // Generate query functions using moonbit-community/postgres types
  buf.write_string("// Query functions\n")
  for query in request.queries {
    generate_query_function_postgres(buf, query, overrides)
  }
  buf.to_string()
}

///|
fn generate_query_function_postgres(
  buf : StringBuilder,
  query : @plugin.Query,
  overrides : Array[TypeOverride],
) -> Unit {
  let func_name = to_snake_case(query.name)
  let sql_const = (to_snake_case(query.name) + "_sql").to_upper()
  let row_type = to_pascal_case(query.name) + "Row"

  // Return type 
  let return_type = match query.cmd {
    ":one" => row_type
    ":many" => "Array[" + row_type + "]"
    ":execrows" => "Int"
    ":execlastid" => "Int"
    _ => "Int"
  }

  // Doc comment — preserves the original line breaks from query.sql.
  backend_write_doc_comment(buf, query)

  // Function signature - type from moonbit-community/postgres
  buf.write_string("pub async fn ")
  buf.write_string(func_name)
  buf.write_string("(client : @pgclient.Client")
  for param in query.params {
    let (param_name, moonbit_type, is_nullable, _pg_type) = param_type_to_moonbit(
      param.column,
      overrides,
    )
    let param_txt = match is_nullable {
      true => "\{param_name}? : \{moonbit_type}? = None"
      false => "\{param_name}~ : \{moonbit_type}"
    }
    buf.write_string(", \{param_txt}")
  }
  buf.write_string(") -> ")
  buf.write_string(return_type)
  buf.write_string(" {\n")

  // Execute query with parameterized binding (safe from SQL injection)
  if query.params.length() > 0 {
    buf.write_string("  let params : Array[&@pgclient.ToSql] = [\n")
    for param in query.params {
      let (param_name, moonbit_type, is_nullable, pg_type) = param_type_to_moonbit(
        param.column,
        overrides,
      )
      write_param_for_type(buf, param_name, moonbit_type, is_nullable, pg_type)
    }
    buf.write_string("  ]\n")
  }
  //buf.write_string(query.to_repr().to_string())
  buf.write_string("\n")
  // Execute based on command type
  match query.cmd {
    ":one" =>
      if query.params.length() > 0 {
        buf.write_string(
          "  client.query_one(\{sql_const}, params~) |> \{func_name}_reader()\n",
        )
      } else {
        buf.write_string(
          "  client.query_one(\{sql_const}) |> \{func_name}_reader()\n",
        )
      }
    ":many" => {
      if query.params.length() > 0 {
        buf.write_string(
          "  let rows = client.query(\{sql_const}, params~).collect()\n",
        )
      } else {
        buf.write_string("  let rows = client.query(\{sql_const}).collect()\n")
      }
      buf.write_string("  rows.map(\{func_name}_reader)\n")
    }
    ":execrows" =>
      if query.params.length() > 0 {
        buf.write_string("  client.execute(\{sql_const}, params~)\n")
      } else {
        buf.write_string("  client.execute(\{sql_const})\n")
      }
    ":execlastid" =>
      if query.params.length() > 0 {
        buf.write_string(
          "  let row = client.query_one(\{sql_const}, params~);\n",
        )
        buf.write_string("  row.get_raw(0) |> @pghelpers.get_as_serial\n")
      } else {
        buf.write_string("  let row = client.query_one(\{sql_const});\n")
        buf.write_string("  row.get_raw(0) |> @pghelpers.get_as_serial\n")
      }
    _ =>
      if query.params.length() > 0 {
        buf.write_string("  client.execute(\{sql_const}, params~)\n")
      } else {
        buf.write_string("  client.execute(\{sql_const})\n")
      }
  }
  buf.write_string("}\n\n")
  if query.columns.length() > 0 {
    write_reader(buf, query, overrides)
  }
}

///|
fn write_reader(
  buf : StringBuilder,
  query : @plugin.Query,
  overrides : Array[TypeOverride],
) -> Unit {
  let reader_const = to_snake_case(query.name) + "_reader"
  let row_type = to_pascal_case(query.name) + "Row"

  // Execute based on command type
  match query.cmd {
    ":one" | ":many" => {
      buf.write_string(
        "pub fn \{reader_const}(row : @pgclient.Row) -> \{row_type} raise {\n",
      )
      for col in query.columns {
        let (col_name, moonbit_type, is_nullable, pg_type) = param_type_to_moonbit(
          col, overrides,
        )
        write_reader_for_type(buf, col_name, moonbit_type, is_nullable, pg_type)
      }
      buf.write_string("\n")
      buf.write_string("  \{row_type}::{")
      for col in query.columns {
        let (col_name, _, _, _) = param_type_to_moonbit(col, overrides)
        buf.write_string("\{col_name}, ")
      }
      buf.write_string("} \n")
      buf.write_string("}\n\n")
    }
    _ => ()
  }
}

///|
fn write_reader_for_type(
  buf : StringBuilder,
  col_name : String,
  moonbit_type : String,
  is_nullable : Bool,
  pg_type : String,
) -> Unit {
  match moonbit_type {
    "@uuid.UUID" =>
      match is_nullable {
        true => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgUUID? = row.get_name(\"\{col_name}\") //  nullable \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : @uuid.UUID? = _\{col_name}.map(@pghelpers.PgUUID::to_uuid) //  nullable \{pg_type}\n",
          )
        }
        false => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgUUID = row.get_name(\"\{col_name}\") //  \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : @uuid.UUID = _\{col_name} |> @pghelpers.PgUUID::to_uuid //  \{pg_type}\n",
          )
        }
      }
    "@time.ZonedDateTime" =>
      match is_nullable {
        true => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgTimestampz? = row.get_name(\"\{col_name}\") //  nullable \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type}? = _\{col_name}.map(@pghelpers.PgTimestampz::to_zoned_date_time) //  nullable \{pg_type}\n",
          )
        }
        false => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgTimestampz = row.get_name(\"\{col_name}\") //  \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type} = _\{col_name} |> @pghelpers.PgTimestampz::to_zoned_date_time //  \{pg_type}\n",
          )
        }
      }
    "@time.PlainDateTime" =>
      match is_nullable {
        true => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgTimestamp? = row.get_name(\"\{col_name}\") //  nullable \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type}? = _\{col_name}.map(@pghelpers.PgTimestamp::to_plain_date_time) //  nullable \{pg_type}\n",
          )
        }
        false => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgTimestamp = row.get_name(\"\{col_name}\") //  \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type} = _\{col_name} |> @pghelpers.PgTimestamp::to_plain_date_time //  \{pg_type}\n",
          )
        }
      }
    "@time.PlainDate" =>
      match is_nullable {
        true => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgDate? = row.get_name(\"\{col_name}\") //  nullable \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type}? = _\{col_name}.map(@pghelpers.PgDate::to_plain_date) //  nullable \{pg_type}\n",
          )
        }
        false => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgDate = row.get_name(\"\{col_name}\") //  \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type} = _\{col_name} |> @pghelpers.PgDate::to_plain_date //  \{pg_type}\n",
          )
        }
      }
    "@time.PlainTime" =>
      match is_nullable {
        true => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgTime? = row.get_name(\"\{col_name}\") //  nullable \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type}? = _\{col_name}.map(@pghelpers.PgTime::to_plain_time) //  nullable \{pg_type}\n",
          )
        }
        false => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgTime = row.get_name(\"\{col_name}\") //  \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type} = _\{col_name} |> @pghelpers.PgTime::to_plain_time //  \{pg_type}\n",
          )
        }
      }
    "@pghelpers.Interval" =>
      match is_nullable {
        true => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgInterval? = row.get_name(\"\{col_name}\") //  nullable \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type}? = _\{col_name}.map(@pghelpers.PgInterval::to_period_duration) //  nullable \{pg_type}\n",
          )
        }
        false => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgInterval = row.get_name(\"\{col_name}\") //  \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type} = _\{col_name} |> @pghelpers.PgTime::to_period_duration //  \{pg_type}\n",
          )
        }
      }
    "@pghelpers.TimeTz" =>
      match is_nullable {
        true => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgTimeTz? = row.get_name(\"\{col_name}\") //  nullable \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type}? = _\{col_name}.map(@pghelpers.PgTimeTz::to_timetz) //  nullable \{pg_type}\n",
          )
        }
        false => {
          buf.write_string(
            "  let _\{col_name} : @pghelpers.PgTimeTz = row.get_name(\"\{col_name}\") //  \{pg_type}\n",
          )
          buf.write_string(
            "  let \{col_name} : \{moonbit_type} = _\{col_name} |> @pghelpers.PgTimeTz::to_timetz //  \{pg_type}\n",
          )
        }
      }
    _ =>
      match is_nullable {
        true => {
          let reader_txt = "\{col_name} : \{moonbit_type}?"
          buf.write_string(
            "  let \{reader_txt} = row.get_name(\"\{col_name}\") //  nullable \{pg_type}\n",
          )
        }
        false => {
          let reader_txt = "\{col_name} : \{moonbit_type}"
          buf.write_string(
            "  let \{reader_txt} = row.get_name(\"\{col_name}\") //  \{pg_type}\n",
          )
        }
      }
  }
}

///|
fn write_param_for_type(
  buf : StringBuilder,
  param_name : String,
  moonbit_type : String,
  is_nullable : Bool,
  pg_type : String,
) -> Unit {
  match moonbit_type {
    "@uuid.UUID" =>
      if is_nullable {
        buf.write_string(
          "       \{param_name}.map(@pghelpers.PgUUID::of_uuid) as &@pgclient.ToSql, //  \{moonbit_type} -> nullable \{pg_type}\n",
        )
      } else {
        buf.write_string(
          "       @pghelpers.PgUUID::of_uuid(\{param_name}) as &@pgclient.ToSql, //  \{moonbit_type} -> \{pg_type}\n",
        )
      }
    "@time.ZonedDateTime" =>
      if is_nullable {
        buf.write_string(
          "       \{param_name}.map(@pghelpers.PgTimestampz::of_zoned_date_time) as &@pgclient.ToSql, //  \{moonbit_type} -> nullable \{pg_type}\n",
        )
      } else {
        buf.write_string(
          "       @pghelpers.PgTimestampz::of_zoned_date_time(\{param_name}) as &@pgclient.ToSql, //  \{moonbit_type} -> \{pg_type}\n",
        )
      }
    "@time.PlainDateTime" =>
      if is_nullable {
        buf.write_string(
          "       \{param_name}.map(@pghelpers.PgTimestamp::of_plain_date_time) as &@pgclient.ToSql, //  \{moonbit_type} -> nullable \{pg_type}\n",
        )
      } else {
        buf.write_string(
          "       @pghelpers.PgTimestamp::of_plain_date_time(\{param_name}) as &@pgclient.ToSql, //  \{moonbit_type} -> \{pg_type}\n",
        )
      }
    "@time.PlainDate" =>
      if is_nullable {
        buf.write_string(
          "       \{param_name}.map(@pghelpers.PgDate::of_plain_date) as &@pgclient.ToSql, //  \{moonbit_type} -> nullable \{pg_type}\n",
        )
      } else {
        buf.write_string(
          "       @pghelpers.PgDate::of_plain_date(\{param_name}) as &@pgclient.ToSql, //  \{moonbit_type} -> \{pg_type}\n",
        )
      }
    "@time.PlainTime" =>
      if is_nullable {
        buf.write_string(
          "       \{param_name}.map(@pghelpers.PgTime::of_plain_time) as &@pgclient.ToSql, //  \{moonbit_type} -> nullable \{pg_type}\n",
        )
      } else {
        buf.write_string(
          "       @pghelpers.PgTime::of_plain_time(\{param_name}) as &@pgclient.ToSql, //  \{moonbit_type} -> \{pg_type}\n",
        )
      }
    "@pghelpers.Interval" =>
      if is_nullable {
        buf.write_string(
          "       \{param_name}.map(@pghelpers.PgInterval::of_period_duration) as &@pgclient.ToSql, //  \{moonbit_type} -> nullable \{pg_type}\n",
        )
      } else {
        buf.write_string(
          "       @pghelpers.PgInterval::of_period_duration(\{param_name}) as &@pgclient.ToSql, //  \{moonbit_type} ->  \{pg_type}\n",
        )
      }
    "@pghelpers.TimeTz" =>
      if is_nullable {
        buf.write_string(
          "       \{param_name}.map(@pghelpers.PgTimeTz::of_timetz) as &@pgclient.ToSql, //  \{moonbit_type} -> nullable \{pg_type}\n",
        )
      } else {
        buf.write_string(
          "       @pghelpers.PgTimeTz::of_timetz(\{param_name}) as &@pgclient.ToSql, //  \{moonbit_type} -> \{pg_type}\n",
        )
      }
    _ =>
      if is_nullable {
        buf.write_string(
          "       \{param_name} as &@pgclient.ToSql,  //  \{moonbit_type} -> nullable \{pg_type}\n",
        )
      } else {
        buf.write_string(
          "       \{param_name} as &@pgclient.ToSql,  //  \{moonbit_type} ->  \{pg_type}\n",
        )
      }
  }
}

///|
/// Every target should have a custom mapping so that the end user api is smooth. Dont impose Sqlite int64 on everyone
fn param_type_to_moonbit(
  col : @plugin.Column,
  overrides : Array[TypeOverride],
) -> (String, String, Bool, String) {
  // Check for override first
  let param_name = to_snake_case(col.name)
  match find_column_override(col, overrides) {
    Some(override_) => {
      let base_type = override_.moonbit_type
      // Determine nullability: explicit override > column definition
      let is_nullable = match override_.nullable {
        Some(n) => n
        None => !col.not_null
      }

      (param_name, base_type, is_nullable, col.type_.name)
    }
    None => {
      // Default type mapping
      let _type_name = col.type_.name.to_upper()
      let type_name = _type_name.split(".").last().unwrap_or(_type_name)
      let _base_type = match type_name {
        // Integer types - SQLite INTEGER is 64bit, so use Int64 for consistency
        "INTEGER" => "Int"
        "INT" => "Int"
        "INT4" => "Int16"
        "INT8" => "Int16"
        "BIGINT" => "BigInt"
        "SMALLSERIAL" => "Int16"
        "SERIAL" => "Int"
        "BIGSERIAL" => "Int64"
        "INT2" | "SMALLINT" => "Int16"
        // Floating point types
        "REAL" | "FLOAT4" | "FLOAT8" | "FLOAT" => "Float"
        "DOUBLE PRECISION" | "NUMERIC" | "DECIMAL" => "Double"
        // String types
        "TEXT"
        | "VARCHAR"
        | "CHAR"
        | "CHARACTER"
        | "CHARACTER VARYING"
        | "BPCHAR"
        | "CLOB" => "String"
        // Binary types
        "BLOB" | "BYTEA" => "String"
        // Boolean types
        "BOOLEAN" | "BOOL" => "Bool"
        // Date/Time types (represented as String)
        "TIMESTAMP" => "@time.PlainDateTime"
        "TIMESTAMPTZ" => "@time.ZonedDateTime"
        "TIMESTAMP WITHOUT TIME ZONE" => "@time.PlainDateTime"
        "TIMESTAMP WITH TIME ZONE" => "@time.ZonedDateTime"
        "DATE" => "@time.PlainDate"
        "TIME" => "@time.PlainTime"
        "TIMETZ" => "@pghelpers.TimeTz"
        "TIME WITHOUT TIME ZONE" => "@time.PlainTime"
        "TIME WITH TIME ZONE" => "@pghelpers.TimeTz"
        "INTERVAL" => "@pghelpers.Interval"
        "UUID" => "@uuid.UUID"
        // JSON types (represented as String)
        "JSONB" | "JSON" => "String"
        // Network types (represented as String)
        "INET" | "CIDR" | "MACADDR" | "MACADDR8" => "String"
        // Geometric types (represented as String)
        "POINT" | "LINE" | "LSEG" | "BOX" | "PATH" | "POLYGON" | "CIRCLE" =>
          "String"
        // Range types (represented as String)
        "INT4RANGE"
        | "INT8RANGE"
        | "NUMRANGE"
        | "TSRANGE"
        | "TSTZRANGE"
        | "DATERANGE" => "String"
        _ => "String" // Default to String for unknown types
      }
      let base_type = if col.not_null {
        if col.is_array {
          "Array[" + _base_type + "]"
        } else {
          _base_type
        }
      } else if col.is_array {
        "Array[" + _base_type + "]"
      } else {
        _base_type
      }
      (param_name, base_type, !col.not_null, col.type_.name)
    }
  }
}

///|
pub fn generate_postgres_result_struct(
  buf : StringBuilder,
  struct_name : String,
  columns : Array[@plugin.Column],
  overrides : Array[TypeOverride],
  _query : @plugin.Query,
) -> Unit {
  buf.write_string("pub struct \{struct_name} {\n")
  for col in columns {
    let (col_name, moonbit_type, is_nullable, pg_type) = param_type_to_moonbit(
      col, overrides,
    )
    buf.write_string("    \{col_name} : \{moonbit_type}")
    if is_nullable {
      buf.write_string("?")
    }
    let _typ = if is_nullable { "nullable \{pg_type}" } else { pg_type }
    buf.write_string("  // \{_typ}\n")
  }
  buf.write_string("}")
  buf.write_string("\n\n")
}
